# JONI Docker Environment Configuration
# Copy this file to .env and customize for your setup

# Gateway settings
JONI_GATEWAY_TOKEN=your-secure-token-here
JONI_GATEWAY_PORT=18890
JONI_BRIDGE_PORT=18891
JONI_GATEWAY_BIND=lan

# Image settings
JONI_IMAGE=joni:local

# Config and workspace directories (host paths)
JONI_CONFIG_DIR=./data/config
JONI_WORKSPACE_DIR=./data/workspace

# Claude API keys (optional)
# CLAUDE_AI_SESSION_KEY=
# CLAUDE_WEB_SESSION_KEY=
# CLAUDE_WEB_COOKIE=

# Anthropic API key
ANTHROPIC_API_KEY=sk-ant-YOUR_KEY_HERE

# Optional: Additional apt packages to install
# JONI_DOCKER_APT_PACKAGES="ffmpeg imagemagick"
